{
  "name": "donova-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:pkg": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test:golden": "vitest run --config vitest.golden.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.15.0",
    "turbo": "2.5.0",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "gsap": "3.12.7"
  }
}
