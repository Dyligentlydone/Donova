{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "dist/**",
      "**/dist/**",
      "node_modules/**",
      ".turbo/**",
      "coverage/**",
      "fixtures/**",
      "_analysis/**",
      "packages/runtime/src/generated/**",
      "apps/render-worker/**",
      "plan/**"
    ]
  },
  "organizeImports": { "enabled": true },
  "overrides": [
    {
      "include": ["packages/runtime/src/browser.ts"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ],
  "formatter": {
    "enabled": true,
    "lineWidth": 110,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnusedVariables": "error" },
      "suspicious": { "noExplicitAny": { "level": "warn" } }
    }
  }
}
