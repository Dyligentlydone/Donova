{
  "name": "@donova/studio-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/agent.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "vitest": "2.1.9",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@donova/contract": "workspace:*",
    "@donova/engine": "workspace:*",
    "@donova/producer": "workspace:*",
    "@donova/lint": "workspace:*",
    "@donova/runtime": "workspace:*",
    "parse5": "^7.2.1"
  }
}
