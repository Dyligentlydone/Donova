{
  "name": "@editnce/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "bin", "schemas", "vendor"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "bin": {
    "editnce": "./bin/editnce.mjs",
    "ec": "./bin/editnce.mjs"
  },
  "dependencies": {
    "@editnce/contract": "workspace:*",
    "@editnce/engine": "workspace:*",
    "@editnce/lint": "workspace:*",
    "@editnce/media": "workspace:*",
    "@editnce/producer": "workspace:*",
    "@editnce/runtime": "workspace:*",
    "@editnce/studio-server": "workspace:*",
    "@hyperframes/inspector": "0.9.22",
    "@hyperframes/sdk": "0.9.22",
    "citty": "^0.1.6",
    "hyperframes": "0.9.22",
    "puppeteer-core": "^24.10.0"
  }
}
